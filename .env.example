# Postgres connection. Leave unset in local dev to use the embedded PGlite database (./.pglite).
DATABASE_URL=postgres://showcaller:showcaller@localhost:5432/showcaller

# Sync server: one port serves the HTTP API, the show channel (ws /), and doc sync (ws /doc).
PORT=8787

# Web build-time endpoints (public URLs of the sync server)
NEXT_PUBLIC_SYNC_HTTP_URL=http://localhost:8787
NEXT_PUBLIC_SYNC_WS_URL=ws://localhost:8787
NEXT_PUBLIC_DOC_WS_URL=ws://localhost:8787/doc

# Locks the server: without this, anyone reaching it is an administrator.
# Set it on any deployment that is not your own laptop.
ADMIN_TOKEN=

# Where invitation links point.
#
# The web app and the sync server are separate services on separate hosts, so
# the sync server cannot work out the app's address by looking at itself. SET
# THIS IN PRODUCTION: unset, invite links are built from the Origin header of
# whichever browser happened to create them, so an admin working from a staging
# URL, an IP address, or a port-forward mints links pointing at that instead of
# your app — and those links go out by email to people who cannot tell.
PUBLIC_WEB_URL=https://app.example.com

# Sending invitations by email. Entirely optional: with no mail server, an
# invitation is still created and the dashboard hands back a link to pass on
# however you already talk to your crew. SMTP_HOST and SMTP_FROM are the two
# that decide whether mail is attempted at all; user/password may be omitted
# for a relay that does not authenticate.
SMTP_HOST=
SMTP_FROM=opencall@example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local development only.
# ALLOW_DEV_JOIN=1 opens the join paths without a token — never set in production.
# PGLITE_DIR moves the embedded database off ./.pglite.
# SYNC_PORT overrides PORT for the sync server alone.
