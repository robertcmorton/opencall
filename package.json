{
  "name": "opencall",
  "private": true,
  "version": "0.39.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "seed": "pnpm --filter @opencall/db run seed",
    "typecheck": "turbo run typecheck",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:security": "bash scripts/security-check.sh",
    "test:layout": "bash scripts/layout-check.sh",
    "test:bars": "node apps/web/scripts/bar-timing.mts",
    "test:clock": "node apps/web/scripts/clock-record.mts"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
